    <LangVersion>7.3</LangVersion><OutputPath>../../.codex-artifacts/keyplan/tests/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TeklaBinPath>C:/Program Files/Tekla Structures/2025.0/bin</TeklaBinPath>
