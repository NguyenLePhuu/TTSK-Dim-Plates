<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><OutputType>Exe</OutputType><PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <TeklaBinPath Condition="'$(TeklaBinPath)' == '' and Exists('C:/TeklaStructures/2025.0/bin')">C:/TeklaStructures/2025.0/bin</TeklaBinPath>
    <TeklaBinPath Condition="'$(TeklaBinPath)' == ''">C:/Program Files/Tekla Structures/2025.0/bin</TeklaBinPath>
    <TeklaStructuresInstallationPath>$(TeklaBinPath)</TeklaStructuresInstallationPath>
    <OutputPath>../../.codex-artifacts/slot07-connections/tests/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TSAppConfigPatcherTask" Version="2.1.3" />
    <Compile Include="../../TTSK Dim Plates/TTSK Dim Plates/PHU_Slot07_ColumnConnections.cs" Link="Slot07.cs" />
    <Compile Include="../../TTSK Dim Plates/TTSK Dim Plates/PHU_Slot07_ColumnGrid.cs" Link="ColumnGrid.cs" />
    <Compile Include="../../TTSK Dim Plates/TTSK Dim Plates/PHU_Slot07_DrawingRoute.cs" Link="DrawingRoute.cs" />
    <Compile Include="../../TTSK Dim Plates/TTSK Dim Plates/PHU_MainPartResolver.cs" Link="MainPartResolver.cs" />
    <Reference Include="Tekla.Structures"><HintPath>$(TeklaBinPath)/Tekla.Structures.dll</HintPath></Reference>
    <Reference Include="Tekla.Structures.Model"><HintPath>$(TeklaBinPath)/Tekla.Structures.Model.dll</HintPath></Reference>
    <Reference Include="Tekla.Structures.Drawing"><HintPath>$(TeklaBinPath)/Tekla.Structures.Drawing.dll</HintPath></Reference>
    <Reference Include="Tekla.Structures.Geometry3d.Compatibility"><HintPath>$(TeklaBinPath)/Tekla.Structures.Geometry3d.Compatibility.dll</HintPath></Reference>
  </ItemGroup>
</Project>
